{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@nx-vite-vercel/shared-types": ["./libs/shared-types/src/index.ts"],
      "@nx-vite-vercel/dal": ["./libs/dal/src/index.ts"],
      "@nx-vite-vercel/ui": ["./libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
