{
  "name": "@nx-vite-vercel/api-nest",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run dev",
        "cwd": "apps/api-nest"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api-nest"],
      "options": {
        "command": "bun build src/main.ts --outdir ../../dist/apps/api-nest --target node",
        "cwd": "apps/api-nest"
      }
    }
  }
}
