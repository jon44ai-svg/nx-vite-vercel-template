{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "storybook-static/**",
    "node_modules/**",
    ".nx/**",
    ".codegraph/**",
    ".venv/**",
    "bun.lock",
    "apps/api-python/**"
  ]
}
